{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip3 install -r requirements.txt",
      "runtime": "python@3.12"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
